# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# pre-Supabase SQLite snapshot kept locally as a rollback safety net.
# Safe to delete once you trust the Supabase migration is final.
/_sqlite_backup/

# generated brief exports — pre-Supabase Storage migration. Folder is
# now obsolete (PDFs live in Storage), kept here so any leftover local
# exports never end up in git.
/public/exports/

# debug/test PDFs from scripts/* — never commit
/brief-mockup.pdf
/test-pdf-embed.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
